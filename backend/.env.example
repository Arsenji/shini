VK_TOKEN=
VK_API_VERSION=5.199

# --- Куда слать заявки ---
# Надёжный вариант: ЛС менеджерам (можно несколько через запятую).
# ID пользователя: откройте профиль → в адресе vk.com/idXXXXXXXX
#   VK_PEER_ID=146507806,225909038
#
# Беседа сообщества (VK_CHAT_ID / peer 2000000…) работает ТОЛЬКО если чат
# виден в «Управление сообществом → Сообщения». Иначе API вернёт 927.
VK_PEER_ID=
VK_CHAT_ID=

HOST=0.0.0.0
PORT=8000

# Для CORS (через запятую)
CORS_ORIGINS=https://shini-1.onrender.com,http://localhost:5173
